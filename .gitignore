__pycache__/
*.pyc
.DS_Store

# Operational state, if Company OS is ever pointed at its own repo.
.company/worktrees/
.company/state/
.claude/worktrees/
.company/events/.lock
.company/events/events.jsonl

# Real test credentials and live engagement evidence — this repo is public
# on GitHub. Never frozen into history: secrets/ holds plaintext
# credentials, and pen_test_*/ dirs hold real auth-bypass/exploitation proof
# against live targets. Both are local-only working state.
.company/secrets/
.company/pen_test_*/
.company/handoffs/

# Forked capability-registry repos, cloned locally by
# tools/sync_external_capabilities.py — never frozen into company-os's own
# git history (foreign licenses, foreign size, foreign history). The fork on
# GitHub (riyanbeski2002/<name>) is the durable copy; this is a disposable
# local working copy, re-clonable any time.
external/*/
!external/README.md
